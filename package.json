    "test:pack": "node scripts/test-pack.mjs",
    "pack:check": "pnpm run test && pnpm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
