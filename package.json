{
  "name": "orca-task-telemetry",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Projects-first AI coding session telemetry for Orca, Claude Code, and Codex",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "bin": {
    "orca-telemetry": "./dist/cli.js"
  },
  "files": ["dist", "README.md", "docs/UAT-PREVIEW.md"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
